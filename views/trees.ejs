<%- include("partials/header", { title, adminName }) %>
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
  <div><h1 class="h2 mb-1">Trees</h1><p class="text-body-secondary mb-0">Browse the registered trees.</p></div>
  <a class="btn btn-primary" href="/trees/new">Add tree</a>
</div>
<section class="card mb-4">
  <div class="card-header bg-white">
    <h2 class="h5 mb-1">All trees <span class="badge text-bg-secondary"><%= trees.length %></span></h2>
    <p class="text-body-secondary small mb-0">Search by tree ID or location and filter by category.</p>
  </div>
  <div class="card-body border-bottom">
    <form class="row g-2" action="/trees" method="get">
      <div class="col-12 col-md"><label class="form-label" for="tree-search">Search trees</label><input class="form-control" id="tree-search" type="search" name="search" value="<%= search %>" placeholder="Search tree ID or location"></div>
      <div class="col-12 col-md-4"><label class="form-label" for="categoryId">Filter by category</label><select class="form-select" id="categoryId" name="categoryId"><option value="">All categories</option><% categories.forEach((category) => { %><option value="<%= category.id %>" <%= categoryId === category.id ? "selected" : "" %>><%= category.name %></option><% }) %></select></div>
      <div class="col-12 col-md-auto"><button class="btn btn-secondary w-100" type="submit">Apply filters</button></div>
    </form>
  </div>
  <% if (trees.length) { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th scope="col">Tree ID</th><th scope="col">Category</th><th scope="col">Location</th><th scope="col">Planting date</th><th scope="col"><span class="visually-hidden">Details</span></th></tr></thead>
        <tbody>
          <% trees.forEach((tree) => { %>
            <tr>
              <td><a class="fw-semibold" href="/trees/<%= tree.id %>"><%= tree.treeId %></a></td>
              <td><a class="badge text-bg-light border text-decoration-none" href="/trees?categoryId=<%= tree.category.id %>"><%= tree.category.name %></a></td>
              <td class="text-body-secondary"><%= tree.location %></td>
              <td><%= tree.plantingDate %></td>
              <td><a class="btn btn-sm btn-outline-secondary" href="/trees/<%= tree.id %>">View</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="text-center p-5">
      <p class="text-body-secondary mb-3"><%= search || categoryId ? "No trees match these filters." : "No trees yet." %></p>
      <% if (search || categoryId) { %><a class="btn btn-outline-secondary" href="/trees">Clear filters</a><% } else { %><a class="btn btn-primary" href="/trees/new">Add tree</a><% } %>
    </div>
  <% } %>
</section>
<%- include("partials/footer", { adminName }) %>
