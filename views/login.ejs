<%- include("partials/header", { title, adminName }) %>
<section class="login-panel">
  <h1><%= title %> to Kebunku Admin</h1>
  <% if (error) { %>
  <p class="text-danger" role="alert"><%= error %></p>
  <% } %>
  <form action="/login" method="post">
    <div class="mb-3">
      <label class="form-label" for="email">Email address</label>
      <input class="form-control" type="email" id="email" name="email" autocomplete="username" placeholder="you@example.com" value="<%= email %>" required />
    </div>
    <div class="mb-3">
      <label class="form-label" for="password">Password</label>
      <input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required />
    </div>
    <button class="btn btn-primary w-100" type="submit">Sign in</button>
  </form>
</section>
<%- include("partials/footer", { adminName }) %>
