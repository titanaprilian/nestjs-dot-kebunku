<%- include("partials/header", { title, adminName }) %>
<p class="mb-3"><a href="/categories">← All categories</a></p>
<div class="mb-4">
  <h1 class="h2 mb-1"><%= categoryId ? "Edit category" : "New category" %></h1>
  <p class="text-body-secondary mb-0">Set the category name and registry code.</p>
</div>
<div class="row g-3 mb-4">
  <div class="col-12 col-lg-9 col-xxl-8">
    <section class="card"><div class="card-body">
      <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
      <form action="<%= categoryId ? "/categories/" + categoryId : "/categories" %>" method="post">
        <div class="mb-3">
          <label class="form-label" for="name">Category name <span class="text-danger">*</span></label>
          <input class="form-control" id="name" name="name" required maxlength="80" value="<%= category ? category.name : "" %>" placeholder="e.g. Durian">
        </div>
        <div class="mb-3">
          <label class="form-label" for="code">Category code <span class="text-danger">*</span></label>
          <input class="form-control" id="code" name="code" required value="<%= category ? category.code : "" %>" <%= category && category.trees.length ? "readonly" : "" %> placeholder="e.g. DR">
          <div class="form-text">Letters and numbers only; stored in uppercase.<% if (category && category.trees.length) { %> Code cannot change while trees reference this category.<% } %></div>
        </div>
        <div class="form-actions d-flex justify-content-end gap-2 border-top pt-3">
          <a class="btn btn-outline-secondary" href="/categories">Cancel</a>
          <button class="btn btn-primary" type="submit"><%= categoryId ? "Save changes" : "Create category" %></button>
        </div>
      </form>
    </div></section>
  </div>
</div>
<%- include("partials/footer", { adminName }) %>
